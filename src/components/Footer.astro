---
import { PORTFOLIO_URL } from "../consts";
import { getUrlLocale, useTranslate } from "../i18n/utils";
const today = new Date();

const locale = getUrlLocale(Astro.url);
const t = useTranslate(locale);
---

<footer class="text-center py-20 opacity-60 text-sm font-mono">
  &copy; 2023-{today.getFullYear()}
  <a href={PORTFOLIO_URL} class="hover:text-primary transition-colors duration-300">Gildo Junior.</a>
  {t("footer.copyright")}
</footer>
