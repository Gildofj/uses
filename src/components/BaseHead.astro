---
import { ClientRouter } from "astro:transitions";
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const base = import.meta.env.BASE_URL;

const { title, description, image = `${base}cover.jpeg` } = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#a855f7" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<!-- Favicon -->
<link rel="icon" href={`${base}favicon.ico`} />
<link
  rel="icon"
  type="image/png"
  href={`${base}favicon-32x32.png`}
  sizes="32x32"
/>
<link
  rel="icon"
  type="image/png"
  href={`${base}favicon-16x16.png`}
  sizes="16x16"
/>

<!-- Apple -->
<link
  rel="apple-touch-icon"
  href={`${base}apple-touch-icon.png`}
  sizes="180x180"
/>
<meta name="apple-mobile-web-app-title" content={title} />
<meta
  name="apple-mobile-web-app-status-bar-style"
  content="black-translucent"
/>
<meta name="apple-mobile-web-app-capable" content="yes" />

<!-- PWA -->
<link rel="manifest" href={`${base}site.webmanifest`} />

<!-- Permission-Policy -->
<meta
  http-equiv="Permissions-Policy"
  content="interest-cohort=(), user-id=()"
/>

<!-- Google -->
<meta
  name="google-site-verification"
  content="AzjfR1JEdo5QFJAHE9ggfNeBrRAASpeT2drc49Rbgt8"
/>

<!-- Astro Transition Animations -->
<ClientRouter />

<!-- Google Analytics -->
<script
  is:inline
  async
  src="https://www.googletagmanager.com/gtag/js?id=G-QZ6F1ZHLVK"></script>

<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag("js", new Date());

  gtag("config", "G-QZ6F1ZHLVK");
</script>

<script is:inline>
  const theme = (() => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
      return "dark";
    }
    return "light";
  })();

  if (theme === "light") {
    document.documentElement.classList.remove("dark");
  } else {
    document.documentElement.classList.add("dark");
  }
</script>
