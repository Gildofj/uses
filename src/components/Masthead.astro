---
import { getUrlLocale, useTranslate } from "../i18n/utils";

const locale = getUrlLocale(Astro.url);
const t = useTranslate(locale);
const base = import.meta.env.BASE_URL;
---

<section class="relative py-20 md:py-32 flex justify-center items-center">
  <div class="absolute w-full h-full overflow-hidden">
    <video
      class="absolute h-auto left-1/2 top-1/2 min-w-full min-h-full object-cover -translate-x-1/2 -translate-y-1/2 opacity-20 dark:opacity-10"
      poster={`${base}masthead-poster.png`}
      autoplay="autoplay"
      muted="muted"
      loop="loop"
      playsinline
      transition:persist
    >
      <source
        src="https://www.dropbox.com/scl/fi/5otian88dprv73kuvquus/masthead.webm?rlkey=kgvvl4ieo5io9ehkzoh0buag4&raw=1"
        type="video/webm; codecs=vp9"
      />
      <source
        src="https://www.dropbox.com/scl/fi/u75y8ys1ufbcmcu5muto6/masthead.mp4?rlkey=zeel8cq1ztc1reu7d41agpt7e&raw=1"
        type="video/mp4"
      />
    </video>
  </div>
  <div class="z-10 text-center px-8">
    <div class="uppercase text-sm mb-4 tracking-widest opacity-70 font-mono">{t("masthead.welcome")}</div>
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight">
      {t("masthead.welcomeTitle")}
      <span class="text-primary">{t("masthead.welcomeTitle.highlight")}</span
      >
    </h1>
  </div>
</section>
