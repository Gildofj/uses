---
import { Image } from "astro:assets";
import { getUrlLocale, useTranslate } from "../i18n/utils";

const locale = getUrlLocale(Astro.url);
const t = useTranslate(locale);
const base = import.meta.env.BASE_URL;
---

<section class="py-20">
  <h2
    class="text-3xl font-bold tracking-tight text-primary mb-12 text-center"
  >
    {t("createdWith.title")}
  </h2>
  <ul class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <li class="group text-center mb-4">
      <a href="https://obsidian.md/" target="_blank" class="block p-4 rounded-3xl bg-white/50 dark:bg-zinc-800/50 shadow-soft-flat shadow-soft-hover transition-all duration-500">
        <div class="overflow-hidden rounded-2xl">
          <Image
            class="transition-transform duration-500 group-hover:scale-105"
            src={`${base}obsidian-banner.png`}
            width={720 * 2}
            height={500 * 2}
            alt="Obsidian banner"
          />
        </div>
        <div class="mt-4 text-xl font-bold">Obsidian</div>
        <div class="opacity-70">{t("createdWith.obsidianDescription")}</div>
      </a>
    </li>
    <li class="group text-center mb-4">
      <a href="https://astro.build/" target="_blank" class="block p-4 rounded-3xl bg-white/50 dark:bg-zinc-800/50 shadow-soft-flat shadow-soft-hover transition-all duration-500">
        <div class="overflow-hidden rounded-2xl">
          <Image
            class="transition-transform duration-500 group-hover:scale-105"
            src={`${base}astro-banner.png`}
            width={720 * 2}
            height={500 * 2}
            alt="Astro banner"
          />
        </div>
        <div class="mt-4 text-xl font-bold">Astro</div>
        <div class="opacity-70">{t("createdWith.astroDescription")}</div>
      </a>
    </li>
  </ul>
</section>
