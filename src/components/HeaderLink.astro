---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { href, class: className, ...props } = Astro.props;

const { pathname } = Astro.url;
const isActive = href === pathname || href === pathname.replace(/\/$/, "");
---

<a
  data-active={isActive}
  class="inline-block py-2 px-4 rounded-xl transition-all duration-300 hover:text-primary hover:bg-white/50 dark:hover:bg-zinc-800/50"
  class:list={[className, { "text-primary font-bold shadow-soft-pressed": isActive }]}
  href={href}
  {...props}
>
  <slot />
</a>
