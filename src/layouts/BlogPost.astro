---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Content from "../components/Content.astro";
import Body from "../components/Body.astro";
import { getUrlLocale, useTranslate } from "../i18n/utils";

type Props = CollectionEntry<"posts">["data"];

const base = import.meta.env.BASE_URL;

const { title, description, heroImage } = Astro.props;
const defaultHeroImage = `${base}masthead-poster.png`;

const locale = getUrlLocale(Astro.url);
---

<html lang={locale}>
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <Body>
    <Header />
    <main class="py-10">
      <Content className="py-20">
        <div class="mb-12">
          <Image
            class="rounded-3xl shadow-soft-flat transition-transform duration-500 hover:scale-[1.01]"
            width={1020}
            height={510}
            src={(heroImage as any) ?? defaultHeroImage}
            alt="Thumbnail"
            transition:name={(heroImage as any)?.src ?? defaultHeroImage}
          />
        </div>
        <h1 class="text-4xl md:text-6xl font-bold tracking-tight text-primary mb-4">{title}</h1>
        <div class="text-xl opacity-70 mb-8">{description}</div>
        <hr class="border-zinc-200 dark:border-zinc-800 my-12" />
        <div class="prose prose-zinc dark:prose-invert max-w-none">
          <slot />
        </div>
      </Content>
      <Footer />
    </main>
  </Body>
</html>
